FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt requirements-api.txt ./
RUN pip install -r requirements-api.txt

COPY core ./core
COPY api ./api

RUN useradd --create-home appuser
USER appuser

# Railway inyecta PORT. Autenticación activada por defecto: definir AUTH_TOKEN en Railway.
ENV PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8000'))"
CMD ["sh", "-c", "uvicorn api.main:crear_app --factory --host 0.0.0.0 --port ${PORT}"]
