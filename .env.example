# ---- API (FastAPI) ----
AUTH_ENABLED=true          # true en producción
AUTH_TOKEN=                # token que acepta la API; definir en Railway, nunca aquí
RESULT_TTL_HOURS=24        # expiración de resultados temporales
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
PORT=8000

# ---- Web (Next.js) ----
API_URL=http://localhost:8000   # dirección (interna) de la API; el navegador nunca la usa directamente
API_TOKEN=                      # mismo valor que AUTH_TOKEN de la API (solo servidor)
WEB_ACCESS_PASSWORD=            # opcional: pide contraseña (HTTP Basic) para entrar a la web
